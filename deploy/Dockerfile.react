# ==========================================
# STAGE 1: VITE BUILDER
# ==========================================
FROM public.ecr.aws/docker/library/node:20-alpine AS deps
WORKDIR /app
COPY soc-frontend/package.json ./
RUN npm install

FROM deps AS builder
WORKDIR /app
COPY soc-frontend/ .
RUN npm run build

# ==========================================
# STAGE 2: NGINX PRODUCTION SERVER
# ==========================================
# ==============================================================================
# 1. 🌐 COMPONENT PLACEMENT & GLOBAL WORKFLOW TRACE
#    - Container Blueprint: React Dashboard and Reverse Proxy.
#    - Upstream: CI/CD Pipeline | Downstream: Production Docker Daemon
# 2. 🛡️ LOGICAL INTENT & SYSTEM RESPONSIBILITY
#    - Executes a multistage build: compiles the raw TypeScript UI using Vite/Node,
#      then discards the Node runtime and serves the static HTML/JS via Nginx.
# 3. 🚨 INFRASTRUCTURE GUARDRAILS & RESOURCE CONSTRAINTS
#    - Architecture: Injects the heavily hardened `deploy/nginx.conf` over the
#      default Nginx configuration. This transforms the static file server into
#      a Layer-7 API Gateway for the entire SOAR platform.
# 4. 🔗 CROSS-MODULE INTERFACE & CONTRACT BOUNDARIES
#    - Binds internally to Port 80.
# 5. ☣️ FAILURE DOMAINS & RESILIENCE STATE
#    - Failure Mode: If the Vite build fails, the Docker build fails.
#    - Fallback State: Preserves the previous running container since Docker won't
#      deploy a broken build.
# ==============================================================================
FROM public.ecr.aws/docker/library/nginx:alpine

# Remove default Nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built React files from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Inject the production split-routing traffic configurations
COPY deploy/nginx.conf /etc/nginx/nginx.conf

# Generate a self-signed fallback certificate for local development so Nginx doesn't crash on startup
RUN apk add --no-cache openssl && \
    mkdir -p /etc/letsencrypt/live/yourdomain.com && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/letsencrypt/live/yourdomain.com/privkey.pem \
    -out /etc/letsencrypt/live/yourdomain.com/fullchain.pem \
    -subj "/C=US/ST=State/L=City/O=Organization/CN=localhost"

RUN chown -R 65532:65532 /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/ /etc/letsencrypt /run || true
USER 65532:65532

# Expose standard HTTP port
EXPOSE 80
EXPOSE 443

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
