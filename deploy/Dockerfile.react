# ==========================================
# STAGE 1: VITE BUILDER
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package configurations and install dependencies
COPY soc-frontend/package.json ./
# COPY soc-frontend/package-lock.json ./
RUN npm install

# Copy source and build
COPY soc-frontend/ .
RUN npm run build

# ==========================================
# STAGE 2: NGINX PRODUCTION SERVER
# ==========================================
FROM nginx:alpine

# Remove default Nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built React files from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Optionally, copy a custom nginx.conf here to handle React Router fallback (try_files $uri /index.html)
# COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Expose standard HTTP port
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
